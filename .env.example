# Copy to .env.local; never commit actual keys.
SCENE_VISION_BASE_URL=https://api.openai.com/v1
SCENE_VISION_MODEL=
SCENE_VISION_KEY=
SCENE_PORT=8766
# Optional comma-separated additional trusted website origins.
SCENE_ALLOWED_ORIGINS=

# Set to marble for actual World API world generation, vision for the previous pipeline.
SCENE_PROVIDER=marble
MARBLE_BASE_URL=https://api.worldlabs.ai/marble/v1
MARBLE_MODEL=marble-1.1
MARBLE_API_KEY=
